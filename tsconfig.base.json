{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "preserve",
    "allowJs": true,

    "types": ["bun"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "noEmit": true,
    "allowImportingTsExtensions": true,

    "paths": {
      "@uassist/core": ["./packages/core/src/index.ts"],
      "@uassist/core/*": ["./packages/core/src/*"],
      "@uassist/server": ["./packages/server/src/index.ts"],
      "@uassist/server/*": ["./packages/server/src/*"]
    }
  }
}
